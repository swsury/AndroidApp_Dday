<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DdayApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 스타일 1 Config Activity (3x2) -->
        <activity
            android:name=".widget.DdayStyle1WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 스타일 2 Config Activity (3x3) -->
        <activity
            android:name=".widget.DdayStyle2WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 스타일 3 Config Activity (4x1) -->
        <activity
            android:name=".widget.DdayStyle3WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 스타일 4 Config Activity (2x2) -->
        <activity
            android:name=".widget.DdayStyle4WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 투명 스타일 2 Config Activity (1x1) -->
        <activity
            android:name=".widget.DdayStyle2TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 투명 스타일 3 Config Activity (3x1) -->
        <activity
            android:name=".widget.DdayStyle3TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 투명 스타일 4 Config Activity (2x2) -->
        <activity
            android:name=".widget.DdayStyle4TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 스타일 1 Provider (3x2) -->
        <receiver
            android:name=".widget.DdayStyle1WidgetProvider"
            android:exported="true"
            android:label="D-day 기본 (3x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style1_widget_info" />
        </receiver>

        <!-- 스타일 2 Provider (1x1) -->
        <receiver
            android:name=".widget.DdayStyle2WidgetProvider"
            android:exported="true"
            android:label="D-day 미니 (1x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style2_widget_info" />
        </receiver>

        <!-- 스타일 3 Provider (4x1) -->
        <receiver
            android:name=".widget.DdayStyle3WidgetProvider"
            android:exported="true"
            android:label="D-day 가로형 (4x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style3_widget_info" />
        </receiver>

        <!-- 스타일 4 Provider (2x2) -->
        <receiver
            android:name=".widget.DdayStyle4WidgetProvider"
            android:exported="true"
            android:label="D-day 미니멀 (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style4_widget_info" />
        </receiver>

        <!-- 투명 스타일 2 Provider (1x1) -->
        <receiver
            android:name=".widget.DdayStyle2TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 투명 미니 (1x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style2_transparent_widget_info" />
        </receiver>

        <!-- 투명 스타일 3 Provider (3x1) -->
        <receiver
            android:name=".widget.DdayStyle3TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 투명 가로형 (3x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style3_transparent_widget_info" />
        </receiver>

        <!-- 투명 스타일 4 Provider (2x2) -->
        <receiver
            android:name=".widget.DdayStyle4TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 투명 (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style4_transparent_widget_info" />
        </receiver>

    </application>

</manifest>