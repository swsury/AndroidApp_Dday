<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DdayApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DdayApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 스타일 1 1x1 미니 위젯 -->
        <activity
            android:name=".widget.DdayStyle1WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle1WidgetProvider"
            android:exported="true"
            android:label="D-day 미니 (1x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style1_widget_info" />
        </receiver>

        <!-- 스타일 1 1x1 미니 위젯 투명 -->
        <activity
            android:name=".widget.DdayStyle1TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle1TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 미니 투명 (1x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style1_transparent_widget_info" />
        </receiver>

        <!-- 스타일 2 3x1 가로형 위젯 -->
        <activity
            android:name=".widget.DdayStyle2WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle2WidgetProvider"
            android:exported="true"
            android:label="D-day 가로형 (3x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style2_widget_info" />
        </receiver>

        <!-- 스타일 2 3x1 가로형 위젯 투명 -->
        <activity
            android:name=".widget.DdayStyle2TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle2TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 가로형 투명 (3x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style2_transparent_widget_info" />
        </receiver>


        <!-- 스타일 3 2x2 기본 위젯  -->
        <activity
            android:name=".widget.DdayStyle3WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle3WidgetProvider"
            android:exported="true"
            android:label="D-day 기본 (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style3_widget_info" />
        </receiver>

        <!-- 스타일 3 2x2 기본 위젯 투명 -->
        <activity
            android:name=".widget.DdayStyle3TransparentWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DdayApp"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DdayStyle3TransparentWidgetProvider"
            android:exported="true"
            android:label="D-day 기본 투명 (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_style3_transparent_widget_info" />
        </receiver>

    </application>

</manifest>